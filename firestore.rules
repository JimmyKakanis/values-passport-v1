rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check if user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Microsoft / OIDC: email may be on token.email or preferred_username (UPN).
    function authEmailLower() {
      return request.auth != null
        ? (
            request.auth.token.email is string && request.auth.token.email.size() > 0
              ? request.auth.token.email.lower()
              : (
                  request.auth.token.preferred_username is string
                  && request.auth.token.preferred_username.size() > 0
                  && request.auth.token.preferred_username.matches('.*@.*')
                    ? request.auth.token.preferred_username.lower()
                    : ''
                )
          )
        : '';
    }

    function isOwnEmailDoc(emailKey) {
      return isAuthenticated()
        && emailKey is string
        && emailKey.size() > 0
        && authEmailLower() == emailKey;
    }

    function studentDocMatchesQueueStudentId(sid) {
      return authEmailLower() != ''
        && get(/databases/$(database)/documents/students/$(sid)).data.email.lower() == authEmailLower();
    }

    function isOwnStudentData(sid) {
      return studentDocMatchesQueueStudentId(sid);
    }

    function isEngagementOwner() {
      return authEmailLower() != ''
        && resource.data.ownerEmail == authEmailLower();
    }

    function isEngagementOwnerWrite() {
      return authEmailLower() != ''
        && request.resource.data.ownerEmail == authEmailLower();
    }

    function validDateKey(key) {
      return key is string && key.size() == 10 && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validPeriodKey(key) {
      return key is string && key.size() > 0 && key.size() <= 32
        && key.matches('^[0-9]{4}-T[1-4]-F[0-9]+$');
    }

    function engagementWriteAllowed(sid) {
      return isEngagementOwnerWrite() || isOwnStudentData(sid);
    }

    function validDailyIntentionData() {
      return request.resource.data.keys().hasAll(['studentId', 'ownerEmail', 'dateKey', 'text', 'createdAt', 'updatedAt'])
        && request.resource.data.studentId is string
        && request.resource.data.ownerEmail is string
        && engagementWriteAllowed(request.resource.data.studentId)
        && validDateKey(request.resource.data.dateKey)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && (!('coreValue' in request.resource.data)
            || request.resource.data.coreValue is string)
        && (!('subValue' in request.resource.data)
            || (request.resource.data.subValue is string
                && request.resource.data.subValue.size() > 0
                && request.resource.data.subValue.size() <= 80));
    }

    function validValueReflectionData() {
      return request.resource.data.keys().hasAll(['studentId', 'ownerEmail', 'coreValue', 'subValue', 'text', 'wordCount', 'createdAt'])
        && request.resource.data.studentId is string
        && request.resource.data.ownerEmail is string
        && engagementWriteAllowed(request.resource.data.studentId)
        && request.resource.data.coreValue is string
        && request.resource.data.subValue is string
        && request.resource.data.subValue.size() > 0
        && request.resource.data.subValue.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.wordCount is int
        && request.resource.data.wordCount >= 0
        && request.resource.data.createdAt is int;
    }

    function validGoalCheckInData() {
      return request.resource.data.keys().hasAll(['goalId', 'studentId', 'ownerEmail', 'periodKey', 'progressText', 'createdAt', 'updatedAt'])
        && request.resource.data.goalId is string
        && request.resource.data.studentId is string
        && request.resource.data.ownerEmail is string
        && engagementWriteAllowed(request.resource.data.studentId)
        && validPeriodKey(request.resource.data.periodKey)
        && request.resource.data.progressText is string
        && request.resource.data.progressText.size() > 0
        && request.resource.data.progressText.size() <= 500
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      // Allow users to update their own login timestamp, otherwise keep it restricted
      allow update: if isAuthenticated(); 
      allow create: if isAuthenticated(); // For seeding/registration
      allow delete: if isAuthenticated(); // Added for admin operations
    }

    // Signatures Collection
    match /signatures/{signatureId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // For teacher approvals/edits
      allow delete: if isAuthenticated(); // Added for progress reset
    }

    // Nominations Collection
    match /nominations/{nominationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // For approvals
      allow delete: if isAuthenticated(); // Added for progress reset
    }

    // Quiz Scores Collection
    match /quiz_scores/{studentId} {
      // Anyone can read scores for the leaderboard
      allow read: if isAuthenticated();
      // Only the student can update their own score
      // Note: We use request.resource.data.score to validate logic if needed
      allow write: if isAuthenticated(); 
      allow delete: if isAuthenticated(); // Added for progress reset
    }

    // Typing high scores (fortnight adjusted WPM leaderboard)
    match /typing_scores/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwnStudentData(studentId)
        && request.resource.data.studentId == studentId
        && request.resource.data.periodKey is string
        && request.resource.data.adjustedWpm is number
        && request.resource.data.wpm is number
        && request.resource.data.accuracy is number
        && request.resource.data.wpm >= 0
        && request.resource.data.wpm <= 180
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100;
      allow delete: if isAuthenticated();
    }

    match /typing_races/{raceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();

      match /participants/{participantId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && isOwnStudentData(participantId);
        allow delete: if isAuthenticated() && isOwnStudentData(participantId);
      }
    }

    match /typing_progress/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwnStudentData(studentId)
        && request.resource.data.studentId == studentId
        && request.resource.data.periodKey is string
        && request.resource.data.variantIndex is int
        && request.resource.data.variantIndex >= 0
        && request.resource.data.variantIndex <= 2
        && (!('storiesCompleted' in request.resource.data)
          || (request.resource.data.storiesCompleted is int
            && request.resource.data.storiesCompleted >= 0
            && request.resource.data.storiesCompleted <= 99));
      allow delete: if isAuthenticated();
    }

    // Claimed Rewards Collection
    match /claimed_rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      allow delete: if isAuthenticated(); // Added for progress reset
    }

    // Planner Collection
    match /planner/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      allow delete: if isAuthenticated(); // Added for progress reset
    }

    // Goals Collection
    match /goals/{goalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Private student engagement (student-only read/write)
    match /daily_intentions/{docId} {
      allow read: if isAuthenticated() && (isEngagementOwner() || isOwnStudentData(resource.data.studentId));
      allow create: if isAuthenticated() && validDailyIntentionData();
      allow update: if isAuthenticated()
        && (isEngagementOwner() || isOwnStudentData(resource.data.studentId))
        && validDailyIntentionData()
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.dateKey == resource.data.dateKey
        && (!resource.data.keys().hasAny(['ownerEmail'])
            || request.resource.data.ownerEmail == resource.data.ownerEmail
            || isOwnStudentData(resource.data.studentId));
      allow delete: if isAuthenticated() && (isEngagementOwner() || isOwnStudentData(resource.data.studentId));
    }

    match /value_reflections/{docId} {
      allow read: if isAuthenticated() && (isEngagementOwner() || isOwnStudentData(resource.data.studentId));
      allow create: if isAuthenticated() && validValueReflectionData();
      allow update, delete: if false;
    }

    match /goal_check_ins/{docId} {
      allow read: if isAuthenticated() && (isEngagementOwner() || isOwnStudentData(resource.data.studentId));
      allow create: if isAuthenticated() && validGoalCheckInData();
      allow update: if isAuthenticated()
        && (isEngagementOwner() || isOwnStudentData(resource.data.studentId))
        && validGoalCheckInData()
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.goalId == resource.data.goalId
        && request.resource.data.periodKey == resource.data.periodKey
        && (!resource.data.keys().hasAny(['ownerEmail'])
            || request.resource.data.ownerEmail == resource.data.ownerEmail
            || isOwnStudentData(resource.data.studentId));
      allow delete: if isAuthenticated() && (isEngagementOwner() || isOwnStudentData(resource.data.studentId));
    }

    // Teachers Collection (New)
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); 
      allow delete: if isAuthenticated(); // Added for admin operations
    }

    // Settings Collection (New)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Custom Rewards Collection (New)
    match /custom_rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Feedback & suggestions (students and teachers; admins review in console)
    match /feedback_submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Email notification preferences (one doc per auth email, lowercase id)
    match /email_preferences/{emailKey} {
      allow read: if isOwnEmailDoc(emailKey);
      allow create, update: if isOwnEmailDoc(emailKey)
        && request.resource.data.email == emailKey
        && request.resource.data.role in ['STUDENT', 'TEACHER']
        && request.resource.data.achievementEmailEnabled is bool
        && request.resource.data.unseenStampsEmailEnabled is bool
        && request.resource.data.studentDigestEnabled is bool
        && request.resource.data.teacherDigestEnabled is bool
        && request.resource.data.frequency in ['WEEKLY', 'DAILY']
        && request.resource.data.updatedAt is int;
      allow delete: if isOwnEmailDoc(emailKey);
    }

    // Student-requested achievement emails (processed by Cloud Function)
    match /achievement_email_queue/{queueId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['studentId', 'achievementId', 'achievementTitle', 'requestedAt'])
        && request.resource.data.studentId is string
        && request.resource.data.achievementId is string
        && request.resource.data.achievementTitle is string
        && request.resource.data.achievementTitle.size() > 0
        && request.resource.data.achievementTitle.size() <= 200
        && (!('achievementDescription' in request.resource.data)
            || (request.resource.data.achievementDescription is string && request.resource.data.achievementDescription.size() <= 2000))
        && request.resource.data.requestedAt is timestamp
        && studentDocMatchesQueueStudentId(request.resource.data.studentId);
      allow read, update, delete: if false;
    }

    // Server-only collections (Firebase Admin SDK)
    match /achievement_email_sent/{id} {
      allow read, write: if false;
    }
    match /digest_stamp_events/{id} {
      allow read, write: if false;
    }
    match /digest_sent/{id} {
      allow read, write: if false;
    }
    match /unseen_stamps_email_sent/{id} {
      allow read, write: if false;
    }
  }
}