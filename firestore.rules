rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check if user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Microsoft / OIDC must expose email on the token for email_preferences rules to match doc id.
    function authEmailLower() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0
        ? request.auth.token.email.lower()
        : '';
    }

    function isOwnEmailDoc(emailKey) {
      return isAuthenticated()
        && emailKey is string
        && emailKey.size() > 0
        && authEmailLower() == emailKey;
    }

    function studentDocMatchesQueueStudentId(sid) {
      return authEmailLower() != ''
        && get(/databases/$(database)/documents/students/$(sid)).data.email.lower() == authEmailLower();
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      // Allow users to update their own login timestamp, otherwise keep it restricted
      allow update: if isAuthenticated(); 
      allow create: if isAuthenticated(); // For seeding/registration
      allow delete: if isAuthenticated(); // Added for admin operations
    }

    // Signatures Collection
    match /signatures/{signatureId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // For teacher approvals/edits
      allow delete: if isAuthenticated(); // Added for progress reset
    }

    // Nominations Collection
    match /nominations/{nominationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // For approvals
      allow delete: if isAuthenticated(); // Added for progress reset
    }

    // Quiz Scores Collection
    match /quiz_scores/{studentId} {
      // Anyone can read scores for the leaderboard
      allow read: if isAuthenticated();
      // Only the student can update their own score
      // Note: We use request.resource.data.score to validate logic if needed
      allow write: if isAuthenticated(); 
      allow delete: if isAuthenticated(); // Added for progress reset
    }

    // Claimed Rewards Collection
    match /claimed_rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      allow delete: if isAuthenticated(); // Added for progress reset
    }

    // Planner Collection
    match /planner/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      allow delete: if isAuthenticated(); // Added for progress reset
    }

    // Goals Collection
    match /goals/{goalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Teachers Collection (New)
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); 
      allow delete: if isAuthenticated(); // Added for admin operations
    }

    // Settings Collection (New)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Custom Rewards Collection (New)
    match /custom_rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Feedback & suggestions (students and teachers; admins review in console)
    match /feedback_submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Email notification preferences (one doc per auth email, lowercase id)
    match /email_preferences/{emailKey} {
      allow read: if isOwnEmailDoc(emailKey);
      allow create, update: if isOwnEmailDoc(emailKey)
        && request.resource.data.email == emailKey
        && request.resource.data.role in ['STUDENT', 'TEACHER']
        && request.resource.data.achievementEmailEnabled is bool
        && request.resource.data.unseenStampsEmailEnabled is bool
        && request.resource.data.studentDigestEnabled is bool
        && request.resource.data.teacherDigestEnabled is bool
        && request.resource.data.frequency in ['WEEKLY', 'DAILY']
        && request.resource.data.updatedAt is int;
      allow delete: if isOwnEmailDoc(emailKey);
    }

    // Student-requested achievement emails (processed by Cloud Function)
    match /achievement_email_queue/{queueId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['studentId', 'achievementId', 'achievementTitle', 'requestedAt'])
        && request.resource.data.studentId is string
        && request.resource.data.achievementId is string
        && request.resource.data.achievementTitle is string
        && request.resource.data.achievementTitle.size() > 0
        && request.resource.data.achievementTitle.size() <= 200
        && (!('achievementDescription' in request.resource.data)
            || (request.resource.data.achievementDescription is string && request.resource.data.achievementDescription.size() <= 2000))
        && request.resource.data.requestedAt is timestamp
        && studentDocMatchesQueueStudentId(request.resource.data.studentId);
      allow read, update, delete: if false;
    }

    // Server-only collections (Firebase Admin SDK)
    match /achievement_email_sent/{id} {
      allow read, write: if false;
    }
    match /digest_stamp_events/{id} {
      allow read, write: if false;
    }
    match /digest_sent/{id} {
      allow read, write: if false;
    }
    match /unseen_stamps_email_sent/{id} {
      allow read, write: if false;
    }
  }
}